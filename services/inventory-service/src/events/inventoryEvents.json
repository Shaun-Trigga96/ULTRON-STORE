{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ULTRONStoreInventoryEvents",
  "description": "AsyncAPI & WebSocket event schemas for real-time pre-owned phone inventory sync",
  "version": "2.0.0",
  "definitions": {
    "InventoryLockedEvent": {
      "type": "object",
      "properties": {
        "eventId": { "type": "string", "format": "uuid" },
        "eventType": { "type": "string", "enum": ["inventory.locked"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "data": {
          "type": "object",
          "properties": {
            "imei": { "type": "string", "pattern": "^[0-9]{15}$" },
            "deviceId": { "type": "string", "format": "uuid" },
            "sessionId": { "type": "string" },
            "ttlSeconds": { "type": "integer", "default": 600 },
            "expiresAt": { "type": "string", "format": "date-time" },
            "status": { "type": "string", "enum": ["LOCKED_CHECKOUT_HOLD"] }
          },
          "required": ["imei", "sessionId", "ttlSeconds", "expiresAt", "status"]
        }
      },
      "required": ["eventId", "eventType", "timestamp", "data"]
    },
    "InventoryReleasedEvent": {
      "type": "object",
      "properties": {
        "eventId": { "type": "string", "format": "uuid" },
        "eventType": { "type": "string", "enum": ["inventory.released"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "data": {
          "type": "object",
          "properties": {
            "imei": { "type": "string", "pattern": "^[0-9]{15}$" },
            "reason": { "type": "string", "enum": ["TTL_EXPIRED", "USER_ABANDONED", "MANUAL_CANCEL"] },
            "status": { "type": "string", "enum": ["AVAILABLE"] }
          },
          "required": ["imei", "reason", "status"]
        }
      },
      "required": ["eventId", "eventType", "timestamp", "data"]
    },
    "InventorySoldEvent": {
      "type": "object",
      "properties": {
        "eventId": { "type": "string", "format": "uuid" },
        "eventType": { "type": "string", "enum": ["inventory.sold"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "data": {
          "type": "object",
          "properties": {
            "imei": { "type": "string", "pattern": "^[0-9]{15}$" },
            "orderId": { "type": "string", "format": "uuid" },
            "buyerUserId": { "type": "string" },
            "sellingPriceCents": { "type": "integer" },
            "status": { "type": "string", "enum": ["SOLD"] }
          },
          "required": ["imei", "orderId", "buyerUserId", "sellingPriceCents", "status"]
        }
      },
      "required": ["eventId", "eventType", "timestamp", "data"]
    }
  }
}
